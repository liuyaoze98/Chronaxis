{
  "mapping_version": 1,
  "path_base": "mapping_directory",
  "io_policy": "explicit_mapping",
  "analysis": {
    "config_version": 4,
    "dataset": {
      "name": "start_end_demo",
      "entity": "device",
      "session": "session",
      "domain": {
        "start": "0s",
        "end": "16s"
      }
    },
    "sources": [
      {
        "name": "input",
        "time": {
          "unit": "s",
          "time_type": "relative",
          "clock": "clock"
        },
        "rows": [
          {
            "time": "0s",
            "values": {
              "begin": 1,
              "done": 0,
              "value": 10
            }
          },
          {
            "time": "2s",
            "values": {
              "begin": 0,
              "done": 1,
              "value": 20
            }
          },
          {
            "time": "3s",
            "values": {
              "begin": 0,
              "done": 0,
              "value": 30
            }
          },
          {
            "time": "4s",
            "values": {
              "begin": 1,
              "done": 0,
              "value": 40
            }
          },
          {
            "time": "6s",
            "values": {
              "begin": 1,
              "done": 0,
              "value": 60
            }
          },
          {
            "time": "9s",
            "values": {
              "begin": 1,
              "done": 0,
              "value": 90
            }
          },
          {
            "time": "10s",
            "values": {
              "begin": 0,
              "done": 0,
              "value": 100
            }
          },
          {
            "time": "11s",
            "values": {
              "begin": 1,
              "done": 0,
              "value": 110
            }
          },
          {
            "time": "14s",
            "values": {
              "begin": 0,
              "done": 1,
              "value": 140
            }
          },
          {
            "time": "16s",
            "values": {
              "begin": 0,
              "done": 0,
              "value": 160
            }
          }
        ],
        "source_type": "memory"
      }
    ],
    "signals": [
      {
        "name": "begin",
        "source": "input",
        "field": "begin",
        "dtype": "int64",
        "unit": "1",
        "valid_for": "20s"
      },
      {
        "name": "done",
        "source": "input",
        "field": "done",
        "dtype": "int64",
        "unit": "1",
        "valid_for": "20s"
      },
      {
        "name": "value",
        "source": "input",
        "field": "value",
        "dtype": "int64",
        "unit": "1",
        "valid_for": "20s"
      }
    ],
    "metrics": [
      {
        "name": "event_average",
        "on": "event:cycle",
        "op": "mean_time",
        "signal": "value"
      },
      {
        "name": "segment_average",
        "on": "segment:window",
        "op": "mean_time",
        "signal": "value"
      }
    ],
    "execution": {
      "batch_rows": 2,
      "result_buffer_rows": 1,
      "memory_budget_bytes": 268435456
    },
    "metadata": {
      "device_label": "home",
      "data_kind": "synthetic"
    }
  },
  "aliases": {
    "Start_Flag": "begin",
    "End_Flag": "done"
  },
  "sections": {
    "TRIGGER_cycle": {
      "name": "cycle",
      "window_id": "window",
      "semantics": "start_end_timeout-v1",
      "emit_initial": true
    }
  }
}
